# General
NODE_ENV=development
PORT=3000

# External AI providers
# GEMINI_API_KEY is the required production fallback for the core LLM gateway.
GEMINI_API_KEY=your_gemini_api_key
# Optional provider/model overrides. Keep models configurable so a provider deprecation does not
# require a source-code patch just to restore service.
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# PostgreSQL
DATABASE_URL=postgresql://devuser:devpassword@localhost:5432/birthvoices?schema=public

# Redis / BullMQ
# Required in production. The server fails fast instead of silently falling back to localhost.
REDIS_URL=redis://localhost:6379

# JWT and Access
JWT_SECRET=your_jwt_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# Comma-separated origins allowed to call the API / connect via Socket.IO.
ALLOWED_ORIGINS=http://localhost:3000

# Voicebox (Local Zero-Cost TTS)
VOICEBOX_API_URL=http://127.0.0.1:17493

# Telephony (Twilio inbound voice)
# PUBLIC_BASE_URL must be the exact public HTTPS origin registered at Twilio; it is part of request
# signature validation. The production deploy requires these variables before promotion.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
PUBLIC_BASE_URL=https://your-public-domain.example.com
# Optional fallback agent when the called number has no Agent.phoneNumber mapping. The resolved
# agent's own tenantId is the ownership boundary.
DEFAULT_AGENT_ID=

# Telephony (Twilio outbound voice)
# Must be a Twilio-owned or verified caller ID. Without it, outbound calls fail closed with 503.
TWILIO_FROM_NUMBER=

# Webhooks emitted by Birth Voices Hub
WEBHOOK_URL=
# HMAC-SHA256 key behind x-birthvoices-signature. Required by the production deployment gate.
WEBHOOK_SIGNING_SECRET=

# Corporate identity (Keycloak / OIDC)
OIDC_ISSUER=http://localhost:8080/realms/birth-voices
OIDC_CLIENT_ID=birth-voices
OIDC_CLIENT_SECRET=

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=birthvoices
S3_SECRET_KEY=change-this-minio-password
S3_RECORDINGS_BUCKET=birth-voice-recordings

# Antivirus ClamAV
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# OpenTelemetry Collector
OTEL_SERVICE_NAME=birth-voices-hub
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional AtlasGR / Bland AI prospecting integration
# If this integration is enabled, configure the whole block. Missing configuration fails closed.
BLAND_API_KEY=
BLAND_WEBHOOK_TOKEN=
# Public HTTPS origin of this Birth Voices deployment, used to build the Bland callback URL.
WEBHOOK_BASE_URL=https://your-public-domain.example.com
# Bind this server-to-server integration to a real Birth Voices tenant. That tenant must have
# explicit AI-provider consent registered before any lead data can be sent to Bland.
ATLASGR_TENANT_ID=
# AtlasGR CRM destination that receives completed call results. No localhost/default fallback exists.
ATLASGR_BASE_URL=https://atlasgr.example.com
# Shared secret required both on AtlasGR -> Birth Voices requests and Birth Voices -> AtlasGR result delivery.
ATLASGR_WEBHOOK_SECRET=
# Recording is deliberately opt-in. Leave false unless the legal/privacy policy for the tenant and
# contacts explicitly authorizes recording and retention with the provider.
BLAND_RECORD_CALLS=false
# Second production-only approval switch enforced by the preflight/deploy guard. Do not set true
# merely to make CI pass; it represents an explicit legal/privacy approval for recording.
BLAND_RECORDING_APPROVED=false
# Dedup window for AtlasGR outbound trigger / completed Bland result callbacks. Default: 24h.
ATLASGR_WEBHOOK_IDEMPOTENCY_TTL_SECONDS=86400

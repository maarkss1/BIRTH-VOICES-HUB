generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  users         User[]
  memberships   Membership[]
  roles         Role[]
  workflows     Workflow[]
  callLogs      CallLog[]
  metrics       Metric[]
  sessions      Session[]
  agents        Agent[]
  auditLogs     AuditLog[]
  settings      Setting[]
  aiConsent     TenantAiConsent?
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  companyName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])

  memberships  Membership[]
  sessions     Session[]
  auditLogs    AuditLog[]

  @@index([tenantId])
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([roleId])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  tenantId    String?  // Null for system roles, populated for custom roles
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  permissions Permission[] @relation("RolePermissions")
  memberships Membership[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  roles       Role[]   @relation("RolePermissions")
}

model Workflow {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  name        String
  description String?
  version     Int      @default(1)
  status      String   @default("draft")
  nodes       Json     @default("[]")
  edges       Json     @default("[]")
  metadata    Json     @default("{}")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  @@index([tenantId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agentId   String?
  channel   String
  status    String   @default("active")
  metadata  Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   Json     @default("{}")
  timestamp DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}

model Agent {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String?
  name          String
  model         String
  configuration Json     @default("{}")
  phoneNumber   String?  @unique

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([tenantId])
  @@index([userId])
}

model CallLog {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  contactName String
  duration    String
  status      String
  time        String
  agent       String
  timestamp   DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}

model Metric {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  name      String
  value     Float
  tags      Json     @default("{}")
  timestamp DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}

model Setting {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  key       String
  value     Json
  isGlobal  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, key])
  @@index([tenantId])
  @@index([userId])
}

// First-class LGPD consent record: whether this tenant has authorized sending its data (contact
// info, call transcripts) to an external AI provider (OpenAI/Anthropic/Gemini/ElevenLabs) via
// LLMGateway. Resolves .agents/handoffs/onda-2/04-para-01-ai-consent-schema.md — Agente 04
// (owner of lib/voice-runtime/**) had been enforcing this via the generic `Setting` table
// (key `ai_provider_consent`) as a real, working, tenant-isolated interim mechanism; this model
// is the dedicated, discoverable (via `prisma studio`/schema) replacement with proper audit
// columns. `settingService.ts` (Agente 04's own file) is expected to switch its
// getAiConsent/grantAiConsent/revokeAiConsent implementation to this model — its public signature
// does not need to change, so LLMGateway.ts/SessionManager.ts/ai.controller.ts (its callers) do
// not need to change either. One row per tenant (`tenantId` is unique): `granted: false` is the
// safe default for a brand-new tenant (fail closed, no regression vs. "no Setting row" today).
model TenantAiConsent {
  id              String    @id @default(uuid())
  tenantId        String    @unique
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  granted         Boolean   @default(false)
  consentVersion  String?
  grantedAt       DateTime?
  revokedAt       DateTime?
  grantedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// SECURITY.md states every model except "core global models" carries a tenantId. APIKey and
// Integration break that invariant today. They are currently dead schema — grep finds zero
// references to `prisma.aPIKey` / `prisma.integration` anywhere in src/ or lib/ — so there is no
// live cross-tenant leak yet. But both are clearly meant to hold tenant-owned data (a tenant's own
// API key, a tenant's configured provider credentials per AGENTS.md's Agent 06/Integrations scope)
// once wired up. Whichever agent implements them MUST add a required `tenantId` (with the same
// `@relation(fields: [tenantId], references: [id], onDelete: Cascade)` + `@@index([tenantId])`
// shape used by every other tenant-scoped model above) as part of that work — not bolt it on after
// the first cross-tenant report. Flagged by Agent 01 (schema owner) during the Onda 1 tenancy
// audit; not fixed preemptively here because the correct shape (nullable vs required, one row per
// tenant vs many) depends on product decisions those agents haven't made yet.
model APIKey {
  id        String   @id @default(uuid())
  keyHash   String   @unique
  name      String
  scopes    Json     @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime?
}

model Integration {
  id        String   @id @default(uuid())
  provider  String
  config    Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Notification.userId is present but there is no tenantId. Since a User already belongs to exactly
// one Tenant, filtering by userId alone is tenant-safe as long as every query also derives userId
// from req.user (never from client input) — same pattern already used by Session/Metric/Setting
// per-user queries elsewhere in this schema. Currently unused (zero references to
// `prisma.notification` in src/) — noted for whichever agent wires it up.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())
}

// Same missing-tenantId caveat as APIKey/Integration above if this ends up holding tenant-specific
// provider configuration (e.g. per-tenant LLM API keys) rather than a system-wide catalog of
// supported providers. Currently unused (zero references to `prisma.aIProvider` in src/ or
// lib/voice-runtime/). Agent 04 owns lib/voice-runtime/** — resolve the intended shape with a
// handoff to Agent 01 before writing to this model for the first time.
model AIProvider {
  id        String   @id @default(uuid())
  name      String
  config    Json     @default("{}")
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
